#!/bin/sh
# 提交前门禁：静态检查 + 全量离线测试。
#
# 启用：git config core.hooksPath .githooks
# 跳过（仅限明知故犯的临时提交）：git commit --no-verify
#
# 设计取舍：
# - 只用 POSIX sh，Git for Windows 自带 sh；
# - python 优先取当前 PATH，找不到再退回项目 venv；
# - 测试全离线（不联网），正常 10 秒内跑完；25 个起子进程的用例在受限沙箱里
#   会以 WinError 5 失败，那是环境限制，正常桌面环境应全绿。

set -e

if command -v python >/dev/null 2>&1; then
    PY=python
elif [ -x ".venv/Scripts/python.exe" ]; then
    PY=".venv/Scripts/python.exe"
elif [ -x ".venv/bin/python" ]; then
    PY=".venv/bin/python"
else
    echo "[pre-commit] 找不到 python，跳过检查" >&2
    exit 0
fi

echo "[pre-commit] pyflakes ..."
"$PY" -m pyflakes src tests tools

if [ "${DANMAKU_SKIP_TESTS:-0}" = "1" ]; then
    echo "[pre-commit] 跳过 pytest（DANMAKU_SKIP_TESTS=1）" >&2
    exit 0
fi

echo "[pre-commit] pytest ..."
"$PY" -m pytest -q
